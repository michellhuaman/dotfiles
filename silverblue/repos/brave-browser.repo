# Brave, from https://brave.com/linux/ (Brave's own brave-browser.repo)
# gpgkey is a local file (see keys.txt): rpm-ostree doesn't fetch https keys.
[brave-browser]
name=Brave Browser
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/brave-core.asc
baseurl=https://brave-browser-rpm-release.s3.brave.com/$basearch
