#!/bin/bash
# Points the sway desktop's theme links (sway, waybar, dunst, rofi, swaylock)
# at the flavor of the current light/dark mode, so a new machine has them.
# Runs after the default theme (50) is set, and again whenever theme-toggle.sh
# changes (hash: {{ include "dot_local/bin/executable_theme-toggle.sh" | sha256sum }}).
set -euo pipefail

"$HOME/.local/bin/theme-toggle.sh" links
