{{- /* Ubuntu (stock GNOME) only. Elsewhere the script is empty, and
       chezmoi skips empty scripts. */ -}}
{{- if eq .chezmoi.osRelease.id "ubuntu" -}}
#!/bin/bash
# GNOME settings:
#   keyboard     US and US International layouts, Caps Lock and Escape
#                swapped (Super+Space switches layouts, GNOME's default)
#   touchpad     tap to click
#   night light  4000 K between sunset and sunrise in Madrid
#   shortcuts    Super+Return Alacritty, Super+Shift+Return Brave,
#                Super+Shift+T theme-toggle.sh, Super+Shift+B ddc-brightness.sh,
#                Super+Shift+E powermenu.sh,
#                Super+E Files (new window), Super+I Settings,
#                Super+Shift+S screenshot (interactive, like Print),
#                Super+F maximize (toggles), Super+W close window,
#                Super+1-4 workspace 1-4, Super+Shift+1-4 move the window
#                there (4 fixed workspaces instead of GNOME's dynamic ones)
# The wallpaper is left to you (Settings > Appearance).
#
# Reruns when this file changes. Settings changed later in GNOME's Settings
# stay until then. Keyboard options and shortcuts are
# added to what's there, never replace it; the only keys taken away are
# Super+1-4 and Super+Shift+1-4 (the dash's apps) for the workspaces.
set -euo pipefail

if ! command -v gsettings >/dev/null; then
  echo "!! gsettings not found, skipping the GNOME settings" >&2
  exit 0
fi
echo "==> GNOME settings (keyboard, touchpad, night light, shortcuts)"

# Adds the string $3 to the string-list setting $1 $2, if it isn't in it yet.
add_to_list() {
  local cur new
  cur="$(gsettings get "$1" "$2")"
  new="$(python3 -c '
import ast, sys
cur, item = sys.argv[1], sys.argv[2]
if cur.startswith("@as "):    # how gsettings prints an empty list
    cur = cur[4:]
items = ast.literal_eval(cur)
if item not in items:
    items.append(item)
print(repr(items))' "$cur" "$3")"
  [[ "$new" == "$cur" ]] || gsettings set "$1" "$2" "$new"
}

# Removes the string $3 from the string-list setting $1 $2, if it's in it.
remove_from_list() {
  local cur new
  cur="$(gsettings get "$1" "$2")"
  new="$(python3 -c '
import ast, sys
cur, item = sys.argv[1], sys.argv[2]
if cur.startswith("@as "):    # how gsettings prints an empty list
    cur = cur[4:]
items = [i for i in ast.literal_eval(cur) if i != item]
print(repr(items))' "$cur" "$3")"
  [[ "$new" == "$cur" ]] || gsettings set "$1" "$2" "$new"
}

# --- keyboard ----------------------------------------------------------
gsettings set org.gnome.desktop.input-sources sources "[('xkb', 'us'), ('xkb', 'us+intl')]"
add_to_list org.gnome.desktop.input-sources xkb-options 'caps:swapescape'

# --- touchpad ----------------------------------------------------------
gsettings set org.gnome.desktop.peripherals.touchpad tap-to-click true

# --- night light -------------------------------------------------------
# Automatic: from sunset to sunrise. GNOME gets those from the location,
# and uses the last one it knew when location services are off (Ubuntu's
# default), so Madrid's goes in as that.
color=org.gnome.settings-daemon.plugins.color
gsettings set "$color" night-light-enabled true
gsettings set "$color" night-light-schedule-automatic true
gsettings set "$color" night-light-temperature 4000
gsettings set "$color" night-light-last-coordinates '(40.4, -3.7)'

# --- shortcuts ---------------------------------------------------------
# GNOME runs the command without a shell, so paths are spelled out.
media_keys=org.gnome.settings-daemon.plugins.media-keys
shortcut() { # $1 id, $2 name, $3 keys, $4 command
  local path="/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/dotfiles-$1/"
  local schema="$media_keys.custom-keybinding:$path"
  gsettings set "$schema" name "$2"
  gsettings set "$schema" binding "$3"
  gsettings set "$schema" command "$4"
  add_to_list "$media_keys" custom-keybindings "$path"
}
shortcut terminal     "Terminal (Alacritty)" '<Super>Return'       'alacritty'
shortcut browser      "Brave"                '<Super><Shift>Return' 'brave-browser'
shortcut theme-toggle "Toggle light/dark"    '<Super><Shift>t'     '{{ .chezmoi.homeDir }}/.local/bin/theme-toggle.sh'
shortcut brightness   "Monitor brightness"   '<Super><Shift>b'     '{{ .chezmoi.homeDir }}/.local/bin/ddc-brightness.sh'
shortcut powermenu    "Power menu"           '<Super><Shift>e'     '{{ .chezmoi.homeDir }}/.local/bin/powermenu.sh'
shortcut files        "Files (new window)"   '<Super>e'            'nautilus --new-window'

# Settings and the screenshot UI are GNOME's own actions, so the keys go
# on those. Settings has none by default, stored as [''].
remove_from_list "$media_keys" control-center ''
add_to_list "$media_keys" control-center '<Super>i'
add_to_list org.gnome.shell.keybindings show-screenshot-ui '<Super><Shift>s'

# Window keys, next to GNOME's defaults (Alt+F10, Alt+F4).
wm_keys=org.gnome.desktop.wm.keybindings
add_to_list "$wm_keys" toggle-maximized '<Super>f'
add_to_list "$wm_keys" close            '<Super>w'

# Workspaces 1-4. GNOME only has
# the workspaces in use plus an empty one, so 3 and 4 often wouldn't exist:
# keep 4 instead.
gsettings set org.gnome.mutter dynamic-workspaces false
gsettings set org.gnome.desktop.wm.preferences num-workspaces 4
# Super+1-4 open the dash's apps, in GNOME Shell and again in Ubuntu's dock
# (which also has Super+Shift+1-4); the dock's are all turned off, leaving
# Super+Ctrl+1-4 unused too.
if gsettings list-schemas | grep -qx org.gnome.shell.extensions.dash-to-dock; then
  gsettings set org.gnome.shell.extensions.dash-to-dock hot-keys false
fi
for n in 1 2 3 4; do
  remove_from_list org.gnome.shell.keybindings "switch-to-application-$n" "<Super>$n"
  add_to_list "$wm_keys" "switch-to-workspace-$n" "<Super>$n"
  add_to_list "$wm_keys" "move-to-workspace-$n"   "<Super><Shift>$n"
done
{{- end }}
