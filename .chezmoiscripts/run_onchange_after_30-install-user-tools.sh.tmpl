#!/bin/bash
# Things that come from neither the distro nor Flathub:
# starship and the JetBrainsMono Nerd Font.
# Reruns when the font version changes.
set -euo pipefail

bin_dir="$HOME/.local/bin"
mkdir -p "$bin_dir"
export PATH="$bin_dir:$PATH"

# --- starship ------------------------------------------------------------
# Latest release, installed once. Not in Fedora's repos, so use upstream's
# installer on both distros. To update later, rerun the installer by hand:
#   curl -sS https://starship.rs/install.sh | sh -s -- --yes --bin-dir ~/.local/bin
if command -v starship >/dev/null; then
  echo "==> $(starship --version | head -1) already installed"
else
  echo "==> starship (latest)"
  curl -fsSL https://starship.rs/install.sh | sh -s -- --yes --bin-dir "$bin_dir"
fi

{{ if or (eq .chezmoi.osRelease.id "ubuntu") (contains "ubuntu" (get .chezmoi.osRelease "idLike" | default "")) -}}
# --- bat ---------------------------------------------------------------
# Ubuntu names the command batcat; link it as bat, like on Fedora.
if command -v batcat >/dev/null && [[ ! -e "$bin_dir/bat" ]]; then
  ln -s "$(command -v batcat)" "$bin_dir/bat"
fi

# --- fd ----------------------------------------------------------------
# Same for fd, which Ubuntu names fdfind.
if command -v fdfind >/dev/null && [[ ! -e "$bin_dir/fd" ]]; then
  ln -s "$(command -v fdfind)" "$bin_dir/fd"
fi

{{ end -}}
# --- bat theme cache -------------------------------------------------------
# Makes the Catppuccin themes in ~/.config/bat/themes known to bat, so the
# --theme in ~/.config/bat/config works from the first run.
if command -v bat >/dev/null; then
  bat cache --build >/dev/null
fi

# --- fonts -------------------------------------------------------------
fontdir="$HOME/.local/share/fonts"

echo "==> JetBrainsMono Nerd Font {{ .fonts.nerd_fonts }}"
rm -rf "$fontdir/JetBrainsMonoNerdFont"
mkdir -p "$fontdir/JetBrainsMonoNerdFont"
curl -fsSL "https://github.com/ryanoasis/nerd-fonts/releases/download/{{ .fonts.nerd_fonts }}/JetBrainsMono.tar.xz" \
  | tar -xJ -C "$fontdir/JetBrainsMonoNerdFont"

fc-cache -f "$fontdir"
