{{ if or (eq .chezmoi.osRelease.id "ubuntu") (contains "ubuntu" (get .chezmoi.osRelease "idLike" | default "")) -}}
#!/bin/bash
# Ubuntu only: snap apps from the Snap Store. Snaps install system-wide, so
# this needs sudo. On Fedora this renders empty and chezmoi skips it.
# Reruns whenever the snap list in .chezmoidata/packages.yaml changes.
set -euo pipefail

if ! command -v snap >/dev/null; then
  echo "!! snap is not installed, skipping snaps" >&2
  exit 0
fi

# The first snap command on a fresh install fails until snapd is seeded.
sudo snap wait system seed.loaded

{{ range .packages.snap -}}
if snap list {{ .name | quote }} >/dev/null 2>&1; then
  echo "==> {{ .name }} already installed"
else
  echo "==> {{ .name }}"
  sudo snap install {{ .name | quote }}{{ if .classic }} --classic{{ end }}
fi
{{ end -}}
{{ end -}}
