#!/bin/bash
# Flatpak apps, installed per user so no root or polkit agent is needed.
# Reruns whenever packages.flatpak in .chezmoidata/packages.yaml changes.
set -euo pipefail

apps=(
{{- range .packages.flatpak }}
  {{ . | quote }}
{{- end }}
)

if ! command -v flatpak >/dev/null; then
  echo "!! flatpak is not installed, skipping apps" >&2
  exit 0
fi

flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
flatpak install --user -y --noninteractive flathub "${apps[@]}"
