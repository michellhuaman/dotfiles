#!/bin/bash
# Enables this session's user units from dot_config/systemd/user, the system
# services every machine needs, and the i2c access ddc-brightness.sh needs.
# Reruns when the service lists in .chezmoidata/packages.yaml change.
set -euo pipefail

user_units=(
{{- range (index .services.user .session) }}
  {{ . | quote }}
{{- end }}
)
system_units=(
{{- range .services.system }}
  {{ . | quote }}
{{- end }}
)

# Units start with graphical-session.target, so enabling is enough here.
if (( ${#user_units[@]} )); then
  if systemctl --user daemon-reload 2>/dev/null; then
    systemctl --user enable "${user_units[@]}"
  else
    echo "!! No systemd user manager reachable; run this later:" >&2
    echo "   systemctl --user enable ${user_units[*]}" >&2
  fi
fi

for unit in "${system_units[@]}"; do
  sudo systemctl enable --now "$unit" || echo "!! Could not enable $unit" >&2
done

# ddcutil talks to external monitors through /dev/i2c-* (both sessions).
echo i2c-dev | sudo tee /etc/modules-load.d/i2c-dev.conf >/dev/null
sudo modprobe i2c-dev || true
if getent group i2c >/dev/null; then
  sudo usermod -aG i2c "$USER"
fi
