#!/bin/bash
# Enables the user units from dot_config/systemd/user listed in
# .chezmoidata/packages.yaml.
# Reruns when the service list in .chezmoidata/packages.yaml changes.
set -euo pipefail

user_units=(
{{- range .services.user }}
  {{ . | quote }}
{{- end }}
)

if (( ${#user_units[@]} )); then
  if systemctl --user daemon-reload 2>/dev/null; then
    systemctl --user enable --now "${user_units[@]}"
  else
    echo "!! No systemd user manager reachable; run this later:" >&2
    echo "   systemctl --user enable --now ${user_units[*]}" >&2
  fi
fi
