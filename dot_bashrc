# .bashrc

# Stop here if not running interactively. Environment variables belong in
# .bash_profile, since GNOME's (non-interactive) login shell stops here too.
[[ $- != *i* ]] && return

#######################################################
# EXPORTS
#######################################################

# Expand the history size
HISTFILESIZE=100000
HISTSIZE=100000
HISTTIMEFORMAT="%F %T " # add timestamp to history

# Don't put duplicate lines in the history and do not add lines that start with a space
HISTCONTROL=ignoreboth:erasedups

# Check the window size after each command and, if necessary, update the values of LINES and COLUMNS
shopt -s checkwinsize

# Causes bash to append to history instead of overwriting it so if you start a new terminal, you have old session history
shopt -s histappend

# Save each command to the history file right away, not only when the shell exits.
# Must come before Starship's init, which moves it to STARSHIP_PROMPT_COMMAND and
# runs it after reading the command's exit status. Skipped when re-sourcing this file.
if [[ "${PROMPT_COMMAND[*]:-} ${STARSHIP_PROMPT_COMMAND:-}" != *"history -a"* ]]; then
  PROMPT_COMMAND="history -a${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
fi

# Tab completion. Ubuntu leaves it to ~/.bashrc
if ! shopt -oq posix && [ -z "${BASH_COMPLETION_VERSINFO:-}" ] \
  && [ -f /usr/share/bash-completion/bash_completion ]; then
  . /usr/share/bash-completion/bash_completion
fi

# Let less open archives and .deb files.
if command -v lesspipe >/dev/null 2>&1; then
  eval "$(SHELL=/bin/sh lesspipe)"
fi

# Colors for ls and grep. Ubuntu leaves them to ~/.bashrc
if command -v dircolors >/dev/null 2>&1; then
  eval "$(dircolors -b)"
fi

#######################################################
# ALIASES
#######################################################
# To temporarily bypass an alias, we precede the command with a \
# EG: the ls command is aliased, but to use the normal ls command you would type \ls

alias list='ls -lAh --color=always --group-directories-first'
alias c='clear'
alias ls='ls --color=auto'
alias grep='grep --color=auto'

# Update aliases
alias update-fw='sudo fwupdmgr refresh && sudo fwupdmgr update'

# Power aliases
alias off='systemctl poweroff'
alias rb='systemctl reboot'
alias zz='systemctl suspend'

# Alias to show the date
alias da='date "+%Y-%m-%d %A %T %Z"'

#######################################################
# FUNCTIONS
#######################################################

# System update (apt), then Flatpak and Snap apps
# Remove any old 'update' alias first so re-sourcing this file doesn't break the function
unalias update 2>/dev/null
update() {
  local status=0
  sudo apt update && sudo apt upgrade && sudo apt autoremove || return 1

  # Update Flatpak apps if Flatpak is installed
  if command -v flatpak >/dev/null 2>&1; then
    flatpak update || status=1
  fi

  # Update Snap packages if Snap is installed
  if command -v snap >/dev/null 2>&1; then
    sudo snap refresh || status=1
  fi

  # CLI tools from ~/.config/mise/config.toml, to their latest releases
  if command -v mise >/dev/null 2>&1; then
    (cd "$HOME" && mise upgrade --yes) || status=1
  fi

  # Ubuntu creates this file when an update needs a reboot (kernel, libc...)
  if [ -f /var/run/reboot-required ]; then
    echo "update: a reboot is required to finish the update"
  fi

  return "$status"
}

# Safely eject a USB drive: usbeject sdb (or sdb1, or /dev/sdb)
usbeject() {
  if [ -z "$1" ]; then
    echo "Usage: usbeject <device>   e.g. usbeject sdb" >&2
    return 1
  fi

  local dev="/dev/${1#/dev/}"
  if [ ! -b "$dev" ]; then
    echo "Error: $dev is not a valid device. Check with lsblk." >&2
    return 1
  fi

  # If a partition was given (sdb1), switch to the whole drive (sdb)
  local parent
  parent=$(lsblk -dno PKNAME "$dev")
  [ -n "$parent" ] && dev="/dev/$parent"

  # Refuse internal disks, so a typo can't power off an NVMe or SATA drive
  if [ "$(lsblk -dno TRAN "$dev")" != "usb" ]; then
    echo "Error: $dev is not a USB drive." >&2
    return 1
  fi

  # Unmount every mounted partition on the drive
  local part
  for part in $(lsblk -lnpo NAME,MOUNTPOINT "$dev" | awk '$2 != "" {print $1}'); do
    udisksctl unmount -b "$part" || return 1
  done

  udisksctl power-off -b "$dev" && echo "$dev is safe to remove."
}

# Edit a dotfile by its real path, then apply it: edot ~/.config/starship.toml
alias edot='chezmoi edit --apply'

# Use Starship prompt
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init bash)"
fi
