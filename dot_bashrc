# .bashrc

# Source global definitions
if [ -f /etc/bashrc ]; then
  . /etc/bashrc
fi

#######################################################
# EXPORTS
#######################################################

# Expand the history size
export HISTFILESIZE=10000
export HISTSIZE=500
export HISTTIMEFORMAT="%F %T" # add timestamp to history

# Don't put duplicate lines in the history and do not add lines that start with a space
export HISTCONTROL=erasedups:ignoredups:ignorespace

# Check the window size after each command and, if necessary, update the values of LINES and COLUMNS
shopt -s checkwinsize

# Causes bash to append to history instead of overwriting it so if you start a new terminal, you have old session history
shopt -s histappend

# Disable systemctl's auto-paging feature
export SYSTEMD_PAGER=

# Use Bitwarden SSH Agent
export SSH_AUTH_SOCK="$HOME/.var/app/com.bitwarden.desktop/data/.bitwarden-ssh-agent.sock"

#######################################################
# ALIAS'S
#######################################################
# To temporarily bypass an alias, we precede the command with a \
# EG: the ls command is aliased, but to use the normal ls command you would type \ls

alias list='ls -lAh --color=always --group-directories-first'
alias c='clear'

# Update aliases
alias update-fw='sudo fwupdmgr refresh && sudo fwupdmgr update'
alias update-starship="curl -sS https://starship.rs/install.sh | sh -s -- --yes --bin-dir ~/.local/bin"

# Power aliases
alias off='systemctl poweroff'
alias rb='systemctl reboot'
alias zz='systemctl suspend'

# Alias to show the date
alias da='date "+%Y-%m-%d %A %T %Z"'

#######################################################
# FUNCTIONS
#######################################################

# System update that works on Fedora (dnf) and Ubuntu/Debian (apt)
# Remove any old 'update' alias first so re-sourcing this file doesn't break the function
unalias update 2>/dev/null
update() {
  if command -v dnf >/dev/null 2>&1; then
    sudo dnf upgrade --refresh || return 1
  elif command -v apt >/dev/null 2>&1; then
    sudo apt update && sudo apt upgrade && sudo apt autoremove || return 1
  else
    echo "update: no supported package manager found (dnf or apt)" >&2
    return 1
  fi

  # Update Flatpak apps if Flatpak is installed
  if command -v flatpak >/dev/null 2>&1; then
    flatpak update
  fi

  # Update Snap packages if Snap is installed (common on Ubuntu)
  if command -v snap >/dev/null 2>&1; then
    sudo snap refresh
  fi
}

# Safely eject a USB drive: usbeject sdb (or sdb1, or /dev/sdb)
usbeject() {
  if [ -z "$1" ]; then
    echo "Usage: usbeject <device>   e.g. usbeject sdb"
    return 1
  fi

  local dev="/dev/${1#/dev/}"
  if [ ! -b "$dev" ]; then
    echo "Error: $dev is not a valid device. Check with lsblk."
    return 1
  fi

  # If a partition was given (sdb1), switch to the whole drive (sdb)
  local parent
  parent=$(lsblk -no PKNAME "$dev" | head -n1)
  [ -n "$parent" ] && dev="/dev/$parent"

  # Unmount every mounted partition on the drive
  local part
  for part in $(lsblk -lnpo NAME,MOUNTPOINT "$dev" | awk '$2 != "" {print $1}'); do
    udisksctl unmount -b "$part" || return 1
  done

  udisksctl power-off -b "$dev" && echo "$dev is safe to remove."
}

# Use Starship prompt
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init bash)"
fi
