# .bash_profile

#######################################################
# EXPORTS
#######################################################

# User specific environment
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="$HOME/.local/bin:$PATH" ;;
esac

# Set up XDG folders
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"

# Set default editor with fallbacks
if command -v nvim >/dev/null 2>&1; then
  export EDITOR="nvim"
  export VISUAL="nvim"
elif command -v vim >/dev/null 2>&1; then
  export EDITOR="vim"
  export VISUAL="vim"
else
  export EDITOR="vi"
  export VISUAL="vi"
fi

# Disable systemctl's auto-paging feature
export SYSTEMD_PAGER=

# Use Bitwarden SSH Agent. Set here, in the login shell GNOME starts the
# session with, so it replaces the socket gcr-ssh-agent sets earlier and
# reaches GUI apps too.
export SSH_AUTH_SOCK="$HOME/.var/app/com.bitwarden.desktop/data/.bitwarden-ssh-agent.sock"

# Get the aliases and functions. Sourced last, so .bashrc sees the PATH above
# (starship lives in ~/.local/bin).
if [ -f ~/.bashrc ]; then
  . ~/.bashrc
fi

