# .bash_profile

#######################################################
# EXPORTS
#######################################################

# User specific environment
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="$HOME/.local/bin:$PATH" ;;
esac

# CLI tools from mise (~/.config/mise/config.toml), through its shims. Set
# here rather than with `mise activate` in .bashrc, so GUI launches (the app
# grid, keybindings) find them too. First on PATH, so they win over any
# distro copy.
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) PATH="$HOME/.local/share/mise/shims:$PATH" ;;
esac

# XDG folders. These are also what programs assume when the variables are
# unset, but some (less's history, for one) only use the XDG folders when
# they're set, and otherwise drop dotfiles in ~.
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"

# Set default editor with fallbacks
if command -v nvim >/dev/null 2>&1; then
  export EDITOR="nvim"
  export VISUAL="nvim"
elif command -v vim >/dev/null 2>&1; then
  export EDITOR="vim"
  export VISUAL="vim"
else
  export EDITOR="vi"
  export VISUAL="vi"
fi

# Use Bitwarden's SSH agent. Set here, in the login shell the desktop session
# starts from, so GUI apps get it too and it replaces any agent socket set
# earlier (such as gcr-ssh-agent's). Skipped on SSH logins, to keep a
# forwarded agent (ssh -A).
if [ -z "${SSH_CONNECTION:-}" ]; then
  export SSH_AUTH_SOCK="$HOME/.var/app/com.bitwarden.desktop/data/.bitwarden-ssh-agent.sock"
fi

# Get the aliases and functions. Sourced last, so .bashrc sees the PATH above
# (starship lives in ~/.local/bin).
if [ -f ~/.bashrc ]; then
  . ~/.bashrc
fi

