# Mounts the Google Drive folder "20-29 SMR" (the remote gdrive: in
# ~/.config/rclone/rclone.conf) at ~/.gdrive/20-29 SMR.
#
# The mount is in a hidden folder so GNOME/Nautilus doesn't list it as a drive
# and probe it (item counts, thumbnails); ~/drive/20-29 SMR links to it.
# Folder listings stay cached and Drive is polled for changes every minute.
#
# Skipped (not failed) until rclone is signed in: on a new machine run
# `rclone config reconnect gdrive:`, then
# `systemctl --user start rclone-smr.service`.
[Unit]
Description=Mount Google Drive "20-29 SMR" with rclone
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
ExecCondition=/usr/bin/grep -q "^token = " "%h/.config/rclone/rclone.conf"
ExecStartPre=/usr/bin/mkdir -p "%h/.gdrive/20-29 SMR"
ExecStart=/usr/bin/rclone mount gdrive: "%h/.gdrive/20-29 SMR" \
  --vfs-cache-mode full \
  --vfs-cache-max-age 720h \
  --dir-cache-time 1000h \
  --poll-interval 1m
ExecStop=/usr/bin/fusermount3 -u "%h/.gdrive/20-29 SMR"
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
