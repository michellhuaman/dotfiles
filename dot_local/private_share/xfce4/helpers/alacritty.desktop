[Desktop Entry]
# Lets Xfce apps (Thunar's "Open Terminal Here") start Alacritty: Sway
# Atomic ships Thunar without Xfce's list of terminals. helpers.rc picks it.
NoDisplay=true
Version=1.0
Type=X-XFCE-Helper
X-XFCE-Category=TerminalEmulator
Name=Alacritty
Icon=Alacritty
X-XFCE-Binaries=alacritty;
X-XFCE-Commands=%B;
X-XFCE-CommandsWithParameter=%B -e "%s";
