// -*- mode: jsonc -*-
// Fedora's waybar config, with a few modules changed. Waybar has no drop-in
// folder, so this file includes Fedora's; settings here win over it.
{
    "include": ["/etc/xdg/waybar/config.jsonc"],

    // At the bottom of the screen (Fedora's is at the top).
    "position": "bottom",

    // No focused-window title in the middle (Fedora's only center module).
    "modules-center": [],

    // "us" or "us intl" (60-keyboard.conf), instead of "us1" / "us2".
    "sway/language": {
        "format": "{short} {variant}"
    }
}
