# dunst. This file exists so that dunst reads dunstrc.d/ next to it: dunst
# only looks for drop-ins beside the dunstrc it uses, and without this file
# that is Fedora's /etc/xdg/dunst/dunstrc. Everything not set here is dunst's
# built-in default, which matches Fedora's file except for the settings below.
#
# Colors: dunstrc.d/80-catppuccin.conf, a link theme-toggle.sh points at
# themes/mocha.conf or themes/latte.conf.

[global]
    enable_recursive_icon_lookup = true
    mouse_middle_click = do_action, close_current
