{{- /* Only written when the image is there: sway treats a missing wallpaper
       file as a config error. The image isn't tracked; on a new machine,
       copy ~/Pictures/wallpapers over and run `chezmoi apply`. Until then
       Fedora's default wallpaper (/etc/sway/config) stays. */ -}}
{{- $wallpaper := joinPath .chezmoi.homeDir "Pictures/wallpapers/0133.jpg" -}}
{{- if stat $wallpaper -}}
# Wallpaper on every screen (replaces Fedora's). fill crops it to cover the
# screen; the image lives in ~/Pictures/wallpapers, outside the dotfiles.
output * bg {{ $wallpaper }} fill
{{ end -}}
