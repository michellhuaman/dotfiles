[Unit]
Description=Lightweight Wayland notification daemon
Documentation=man:mako(1)
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
ConditionEnvironment=|XDG_CURRENT_DESKTOP=sway
ConditionEnvironment=|XDG_CURRENT_DESKTOP=niri

[Service]
# Ready once mako owns the notifications bus name, so nothing sent at login is lost.
Type=dbus
BusName=org.freedesktop.Notifications
ExecStart=/usr/bin/mako
# theme-switch.sh runs `systemctl --user reload mako.service` after editing the config.
ExecReload=/usr/bin/makoctl reload
Restart=on-failure

[Install]
WantedBy=graphical-session.target
