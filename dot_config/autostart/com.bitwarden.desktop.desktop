[Desktop Entry]
# Starts Bitwarden at login so its SSH agent is there for git and ssh.
# sway runs ~/.config/autostart entries once waybar's tray is ready; GNOME
# reads this folder too.
Type=Application
Name=Bitwarden
Icon=com.bitwarden.desktop
Exec=/usr/bin/flatpak run com.bitwarden.desktop
X-GNOME-Autostart-enabled=true
