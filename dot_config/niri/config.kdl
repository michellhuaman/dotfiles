// niri config — based on DistroTube's, cleaned up for Ubuntu + DankMaterialShell
// KDL format: https://kdl.dev   |   Wiki: https://yalter.github.io/niri/Configuration:-Introduction
// "/-" comments out the following node.

// REMOVED: include "monitors.kdl"  (DT's own file, you don't have it -> config fails to load)
// DMS writes its monitor settings to dms/outputs.kdl; see the includes at the bottom.

input {
    keyboard {
        xkb {
            // Same layouts as GNOME: US, then US International (dead keys
            // for accents). Switch with Mod+Space (see binds).
            layout "us,us"
            variant ",intl"
            options "caps:swapescape"
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
        dwt   // disable the touchpad while typing
    }

    mouse {
    }

    // Remove this line if you don't like focus following the mouse.
    focus-follows-mouse max-scroll-amount="0%"
}

// REMOVED: DISPLAY ":1"
// Recent niri starts xwayland-satellite itself and sets DISPLAY automatically.
// Hardcoding ":1" breaks X11 apps (Steam, older Java apps...) if the real display is ":0".
environment {
    _JAVA_AWT_WM_NONREPARENTING "1"
}

cursor {
    hide-when-typing
}

gestures {
    hot-corners {
        off
    }
}

layout {
    gaps 8
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    // DMS overrides these colors with its theme if dms/colors.kdl is included below.
    focus-ring {
        width 1
        active-color "#7fc8ff"
        inactive-color "#282c34"
    }

    border {
        off
        width 1
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }
}

// REMOVED: swayidle  -> DMS already handles idle / screen-off / lock (Settings > Power)
// REMOVED: waypaper + swaybg -> DMS manages the wallpaper; swaybg would fight with it
// REMOVED: emacs --daemon, nextcloud -> DT's apps; add back only if you use them
//
// Start the shell. This is the ONLY place DMS is started: dms.service is masked
// for this user (systemctl --user mask dms) because the package enables it
// for every graphical session, which would also start DMS on top of GNOME.
spawn-sh-at-startup "dms run"

// Autostart apps
spawn-at-startup "flatpak" "run" "com.bitwarden.desktop"

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

// Alt+Tab switcher: square highlight to match the square windows
// (DMS's dms/alttab.kdl would make it rounded; it isn't included).
recent-windows {
    highlight {
        corner-radius 0
    }
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
}

window-rule {
    match title="VirtualBox"
    open-fullscreen true
}

window-rule {
    match app-id=r#"qalculate-gtk$"#
    open-floating true
}

// REMOVED: DT's tastytrade / qutebrowser / brave maximize rules (apps you don't have)

window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
    tiled-state true
    draw-border-with-background false
}

// DankMaterialShell's own windows (settings, etc.): open floating, fully opaque.
// Copied from dms/windowrules.kdl, which is no longer included.
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    open-floating true
    opacity 1.00
}

binds {
    Mod+Shift+Slash hotkey-overlay-title="Show important bindings" { show-hotkey-overlay; }

    // Make sure alacritty and brave are installed, or these binds do nothing.
    Mod+Return hotkey-overlay-title="Open terminal: alacritty" { spawn "alacritty"; }
    Mod+Shift+Return hotkey-overlay-title="Open browser: brave" { spawn "flatpak" "run" "com.brave.Browser"; }
    Mod+D hotkey-overlay-title="App launcher" { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
    Mod+E hotkey-overlay-title="Open file manager: nautilus" { spawn "nautilus" "--new-window"; }
    Mod+Shift+T hotkey-overlay-title="Toggle light/dark theme" { spawn-sh "~/.local/bin/theme-toggle.sh"; }
    Mod+Space hotkey-overlay-title="Switch keyboard layout (US / US Intl)" { switch-layout "next"; }
    // Lock screen is DMS's (rofi/swaylock from the original config are removed).
    Mod+Alt+Minus hotkey-overlay-title="Lock screen" { spawn "dms" "ipc" "call" "lock" "lock"; }
    Mod+Shift+Q hotkey-overlay-title="Quit niri" { quit; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    XF86AudioPlay allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext allow-when-locked=true { spawn-sh "playerctl next"; }

    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }

    Mod+O repeat=false hotkey-overlay-title="Toggle overview" { toggle-overview; }
    Mod+W repeat=false hotkey-overlay-title="Close window" { close-window; }

    Mod+H hotkey-overlay-title="Focus column left" { focus-column-left; }
    Mod+J hotkey-overlay-title="Focus window/workspace down" { focus-window-or-workspace-down; }
    Mod+K hotkey-overlay-title="Focus window/workspace up" { focus-window-or-workspace-up; }
    Mod+L hotkey-overlay-title="Focus column right" { focus-column-right; }

    Mod+Shift+H { move-column-left-or-to-monitor-left; }
    Mod+Shift+J { move-column-to-workspace-down; }
    Mod+Shift+K { move-column-to-workspace-up; }
    Mod+Shift+L { move-column-right-or-to-monitor-right; }

    Mod+Shift+Down { move-window-down; }
    Mod+Shift+Up   { move-window-up; }

    Mod+Home      { focus-column-first; }
    Mod+End       { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    Mod+Comma  { focus-monitor-previous; }
    Mod+Period { focus-monitor-next; }

    Mod+Ctrl+U { move-workspace-down; }
    Mod+Ctrl+I { move-workspace-up; }

    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    Mod+Alt+H { consume-or-expel-window-left; }
    Mod+Alt+L { consume-or-expel-window-right; }

    Mod+BracketLeft  { consume-window-into-column; }
    Mod+BracketRight { expel-window-from-column; }

    Mod+R       { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R  { reset-window-height; }

    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    Mod+Ctrl+F { expand-column-to-available-width; }

    Mod+C      { center-column; }
    Mod+Ctrl+C { center-visible-columns; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Mod+T hotkey-overlay-title="Toggle tabbed display" { toggle-column-tabbed-display; }

    Mod+apostrophe       { screenshot-screen; }
    Mod+Alt+apostrophe   { screenshot-window; }
    Mod+Shift+apostrophe { screenshot; }

    // REMOVED: Mod+semicolon binds -> hardcoded 1794x830 size for DT's monitor

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    Ctrl+Alt+P { power-off-monitors; }
}

// DMS-generated files (DMS rewrites them; don't edit them by hand).
// optional=true: if a file doesn't exist yet (e.g. a new machine before DMS
// has run), niri just logs a warning instead of refusing the whole config.
//   colors.kdl  - focus ring / border / shadow colors, follows the DMS theme
//   outputs.kdl - monitor layout set from DMS settings (per machine)
// Not included:
//   layout.kdl      - gaps/borders/corners are set in this file instead
//   binds.kdl, cursor.kdl - empty
//   windowrules.kdl - its rules are copied into this file (see window rules)
include optional=true "dms/colors.kdl"
include optional=true "dms/outputs.kdl"
